# ProjectForge Backend Environment Configuration (Safe Example Template)
# Copy this file to .env for local development

# Server Port and Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local development placeholder)
MONGO_URI=mongodb://localhost:27017/projectforge

# JWT Authentication Secret (Placeholder only - use strong secret in real deployment)
JWT_SECRET=development_jwt_secret_placeholder_not_for_production

# Frontend Client URL (For CORS whitelist)
CLIENT_ORIGIN=http://localhost:5173
